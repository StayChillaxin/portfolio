/* Deep maroon and muted-gold concentric bands create the animated background. */
.background-art {
  position: fixed;
  inset: -35vmax;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(circle at center,
      #26060c 0 14%,
      #4f1019 14.2% 22%,
      #26060c 22.2% 27%,
      #8b6639 27.2% 28.5%,
      #58131e 28.7% 38%,
      #26060c 38.2% 44%,
      #681a27 44.2% 54%,
      #a17b47 54.2% 55.8%,
      #4d1019 56% 66%,
      #26060c 66.2% 73%,
      #641824 73.2% 84%,
      #98703f 84.2% 85.5%,
      #30070f 85.7% 100%);
  transform-origin: center;
  animation: ring-drift 34s ease-in-out infinite alternate;
}

.background-art::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(
    115deg,
    rgba(20, 2, 6, 0.10),
    transparent 48%,
    rgba(205, 163, 92, 0.05)
  );
}

@keyframes ring-drift {
  from { transform: rotate(-7deg) scale(0.94); }
  to { transform: rotate(7deg) scale(1.06); }
}

