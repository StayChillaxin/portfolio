/* Page-load entrance animation, activated by script.js. */
.motion-item {
  opacity: 0;
  transform: translateY(22px);
}

.page-loaded .motion-item {
  animation: rise-in 700ms cubic-bezier(0.2, 0.75, 0.25, 1) forwards;
}

.page-loaded .motion-item:nth-child(2) { animation-delay: 100ms; }
.page-loaded .motion-item:nth-child(3) { animation-delay: 190ms; }
.page-loaded .motion-item:nth-child(4) { animation-delay: 280ms; }
.page-loaded .motion-item:nth-child(5) { animation-delay: 370ms; }
.page-loaded .motion-item:nth-child(6) { animation-delay: 460ms; }

@keyframes rise-in {
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .motion-item { opacity: 1; transform: none; }
}

